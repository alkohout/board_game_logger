# Copy to ~/.config/pg_backup/region_move.env and chmod 600.
# Never commit the filled-in version — it holds two sets of credentials.
#
# Both URLs must be the DIRECT endpoint, not the -pooler one: pg_dump and
# pg_restore need session state a pooled connection won't hold.
#
# In the Neon console the direct endpoint is the host WITHOUT "-pooler":
#   ep-something-123456.ap-southeast-2.aws.neon.tech

# The project you are moving away from (us-east-1).
OLD_URL="postgresql://neondb_owner:PASSWORD@ep-OLD.c-8.us-east-1.aws.neon.tech/neondb?sslmode=require"

# The new project, created with:
#   neon projects create --name board-game-logger-syd --region-id aws-ap-southeast-2
NEW_URL="postgresql://neondb_owner:PASSWORD@ep-NEW.ap-southeast-2.aws.neon.tech/neondb?sslmode=require"

# The password the app connects with. Use the SAME value as PASSWORD in the
# server's .env, or the app won't be able to log in after the switch.
BGL_APP_PASSWORD="the-bgl_app-password"

# Where the dump is written (created 0700).
# OUT_DIR="$HOME/pg_region_move"
